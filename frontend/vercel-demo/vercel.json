{
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/citizen/market",
      "destination": "/citizen-pay/market/index.html"
    },
    {
      "source": "/citizen/waste",
      "destination": "/citizen-pay/waste/index.html"
    },
    {
      "source": "/staff-demo/market",
      "destination": "/citizen-pay/staff/market/index.html"
    },
    {
      "source": "/staff-demo/waste",
      "destination": "/citizen-pay/staff/waste/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/citizen",
      "destination": "/",
      "permanent": false
    }
  ]
}
