# Application
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=smartgov
DB_PASSWORD=smartgov_password
DB_DATABASE=smartgov_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_DOCUMENTS=smartgov-documents
MINIO_BUCKET_AVATARS=smartgov-avatars
MINIO_BUCKET_SIGNATURES=smartgov-signatures
MINIO_BUCKET_TEMP=smartgov-temp

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=SmartGov Office
SMTP_FROM_EMAIL=noreply@smartgov.local

# LINE Notify
LINE_NOTIFY_TOKEN=your-line-notify-token

# LINE OA (Messaging API)
LINE_CHANNEL_ID=your-channel-id
LINE_CHANNEL_SECRET=your-channel-secret
LINE_CHANNEL_ACCESS_TOKEN=your-channel-access-token

# Rate Limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,xlsx,jpg,jpeg,png,zip

# Puppeteer (PDF)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# ─── AI อ่านหนังสือ → กรอกฟอร์มสร้างสารบรรณ (POST /v1/correspondence/ai-extract) ───
# ไม่ตั้ง key = AI ใช้ไม่ได้ (หน้าเว็บให้กรอกเองตามเดิม) · ไฟล์หนังสือถูกส่งไปประมวลผลที่ผู้ให้บริการ AI
# ผู้ให้บริการ: anthropic (Claude, ค่าเริ่มต้น) | gemini (Google)
AI_EXTRACT_PROVIDER=anthropic
# Claude — โมเดลค่าเริ่มต้น claude-opus-5-5
ANTHROPIC_API_KEY=
AI_EXTRACT_MODEL=claude-opus-5-5
# Gemini — key จาก aistudio.google.com · โมเดลค่าเริ่มต้น gemini-3.5-flash (คนใช้เยอะจะลองรุ่นสำรองให้เอง)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Initial Admin
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@smartgov.local
INITIAL_ADMIN_PASSWORD=Admin@123456
