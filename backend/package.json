{
  "name": "smartgov-backend",
  "version": "1.0.0",
  "description": "SmartGov Office - Backend API",
  "author": "SmartGov Team",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run -d src/config/typeorm.config.ts",
    "migration:run:prod": "node dist/run-migrations.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/typeorm.config.ts",
    "seed:run": "ts-node src/database/seeds/run-seeds.ts",
    "seed:reset": "ts-node src/database/seeds/run-seeds.ts --reset",
    "seed:perms": "ts-node src/database/seeds/run-roles-permissions.ts",
    "seed:perms:prod": "node dist/database/seeds/run-roles-permissions.js",
    "seed:demo-monthly": "ts-node src/database/seeds/run-demo-monthly.ts",
    "rework:rbac": "ts-node src/database/seeds/rework-rbac-lamnangrong.ts",
    "rework:rbac:prod": "ts-node src/database/seeds/rework-rbac-lamnangrong.ts --prod",
    "rework:rbac:prod:dist": "node dist/database/seeds/rework-rbac-lamnangrong.js --prod",
    "seed:demo-monthly:prod": "node dist/database/seeds/run-demo-monthly.js",
    "seed:water-admin": "ts-node src/database/seeds/seed-water-admin.ts",
    "sync:prapa": "ts-node src/database/seeds/sync-prapa-legacy.ts",
    "sync:prapa:prod": "node dist/database/seeds/sync-prapa-legacy.js",
    "seed:water-admin:prod": "node dist/database/seeds/seed-water-admin.js",
    "seed:super-admin": "ts-node src/database/seeds/seed-super-admin.ts",
    "seed:super-admin:prod": "node dist/database/seeds/seed-super-admin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@nestjs/bull": "^10.1.1",
    "@nestjs/cache-manager": "^2.2.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.3.0",
    "@supabase/supabase-js": "^2.108.1",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.1",
    "bull": "^4.12.2",
    "cache-manager": "^5.4.0",
    "cache-manager-ioredis-yet": "^2.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "dayjs": "^1.11.10",
    "exceljs": "^4.4.0",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "minio": "^7.1.3",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.11.5",
    "pngjs": "^7.0.0",
    "puppeteer": "^22.6.0",
    "qrcode": "^1.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "speakeasy": "^2.0.0",
    "swagger-ui-express": "^5.0.0",
    "tesseract.js": "^5.0.5",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.6.0",
    "@typescript-eslint/parser": "^7.6.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
