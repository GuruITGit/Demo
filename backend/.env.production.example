# ===== SmartGov Backend — Production (Supabase + Render) =====

# App
NODE_ENV=production
PORT=4000
APP_URL=https://your-app.onrender.com
FRONTEND_URL=https://your-app.vercel.app

# Database (Supabase → Settings → Database → Connection string → URI)
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-supabase-db-password
DB_DATABASE=postgres
DB_SYNCHRONIZE=false
DB_LOGGING=false

# JWT (สร้าง random string ยาวๆ)
JWT_SECRET=replace-with-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Supabase Storage (Supabase → Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# MinIO (ไม่ต้องตั้งค่าถ้าใช้ Supabase Storage)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Rate Limit
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# File Upload
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,xlsx,jpg,jpeg,png,zip

# Puppeteer (Render มี Chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Admin เริ่มต้น
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@smartgov.local
INITIAL_ADMIN_PASSWORD=Admin@123456
